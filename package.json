{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run --project spec --project rules --project server",
    "test:rules": "vitest run --project rules",
    "sim:test": "vitest run --project sim",
    "test:server": "vitest run --project server",
    "start": "node server/main.ts",
    "build": "vite build --config client/vite.config.ts",
    "dev": "vite build --watch --config client/vite.config.ts & node --watch --disable-warning=ExperimentalWarning server/main.ts"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "jsdom": "^30.1.0",
    "playwright-core": "^1.63.0",
    "preact": "^11.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "marked": "^18.0.14",
    "ws": "^8.22.0"
  }
}
